// Fleet Console — showcases Router, shared Context (`context`/`use`), pure `fn`,
// Slots (`@ui/Panel`), Portals, Tagged-Union ADTs, generic enums, `on_enter`,
// state-scoped `on_key("Escape")`, `Form`/`Select`/`Slider`/`Progress`,
// `Catch`/`Fallback` error boundaries, and verified `foar.toml` + `foar.lock` packages.
import "@ui/Badge"
import "@ui/Panel"

data Service {
    id: String,
    name: String,
    region: String,
    healthy: bool,
    latency_ms: i32,
}

enum ProbeState<T> {
    Idle,
    Online(T),
    Down(String),
}

fn format_slo(ms: i32) -> String {
    return "{ms} ms p95 SLO";
}

context FleetPrefs {
    store region: String = "all";
    store slo_ms: i32 = 100;
    let slo_label: String = format_slo(slo_ms);

    effect SetRegion(next: String) { region = next; }
    effect SetSlo(ms: i32) { slo_ms = ms; }
    effect ResetDefaults() {
        region = "all";
        slo_ms = 100;
    }
}

style NavLink {
    padding: 6px 12px;
    border-radius: 6px;
    text-decoration: none;
    color: #334155;
    font-weight: 500;
    font-size: 14px;
    @hover { background: #f1f5f9; }
}

view App {
    use FleetPrefs;

    store services: Vec<Service> = [
        Service { id: "edge-us", name: "Edge API (US-East)", region: "iad", healthy: true, latency_ms: 14 },
        Service { id: "edge-eu", name: "Edge API (EU-West)", region: "fra", healthy: true, latency_ms: 21 },
        Service { id: "worker-db", name: "Replica Writer", region: "sjc", healthy: false, latency_ms: 148 },
    ];
    store probe: ProbeState<i32> = ProbeState.Online(14);
    store modal_open: bool = false;
    store fault_test: bool = false;
    store visits: i32 = 0;

    let visible_services = services.filter(|s| FleetPrefs.region == "all" || s.region == FleetPrefs.region);

    style {
        layout: vertical;
        gap: 16px;
        padding: 24px;
        font-family: system-ui, -apple-system, sans-serif;
    }

    state Ready {
        on_enter { visits += 1; }
        on_key("Escape") { modal_open = false; }

        render {
            Column {
                Row {
                    Text("Fleet").style({ font-size: 20px; font-weight: 700; margin-right: 12px; })
                    Link("/", "Overview").style(NavLink)
                    Link("/services", "Services").style(NavLink)
                    Link("/settings", "Settings").style(NavLink)
                    Text("{FleetPrefs.slo_label} · {route.path}").style({
                        margin-left: auto;
                        font-family: monospace;
                        font-size: 12px;
                        color: #64748b;
                        background: #f1f5f9;
                        padding: 4px 8px;
                        border-radius: 4px;
                    })
                }.style({ border-bottom: 1px solid #e2e8f0; padding-bottom: 12px; })

                Router {
                    Route("/") {
                        Panel(subtitle: "Cluster Overview") {
                            Row(slot: "header") {
                                Text("Cluster Overview").style({ font-size: 16px; font-weight: 700; })
                                Badge(text: "Session #{visits}", tone: "ok")
                            }

                            Text("Router, Context, pure fn, Slots, Portals, Tagged-Union ADTs, and Catch boundaries share one compiled runtime.").style({ color: #475569; font-size: 14px; })

                            Match(probe) {
                                Online(ms) => Badge(text: "Probe OK — {ms} ms", tone: "ok")
                                Down(reason) => Badge(text: "Probe Down — {reason}", tone: "warn")
                                Idle => Text("Probe idle")
                            }

                            Catch {
                                Text(fault_test ? null.explode : "Error boundary healthy — sibling views isolated.").style({ font-size: 13px; color: #334155; })
                            } Fallback { err =>
                                Text("Recovered in {err.view}: {err.message}").style({ font-size: 13px; color: #b91c1c; font-weight: 600; })
                            }

                            Row(slot: "footer") {
                                Button("Open Services") -> on_click(GoServices)
                                Button("Simulate Outage") -> on_click(SimulateOutage)
                                Button("Test Error Boundary") -> on_click(TriggerFault)
                                Button("Restart Modal (Portal)") -> on_click(OpenModal)
                            }
                        }
                    }
                    Route("/services") {
                        List(visible_services, empty: "No services in selected region.") { svc =>
                            Row {
                                Link("/services/{svc.id}", svc.name).style({ font-weight: 600; color: #0f4c81; text-decoration: none; flex: 1; })
                                Text("{svc.latency_ms} ms").style({ font-family: monospace; font-size: 13px; color: #64748b; })
                                Badge(text: svc.latency_ms <= FleetPrefs.slo_ms && svc.healthy ? "Healthy" : "Degraded", tone: svc.latency_ms <= FleetPrefs.slo_ms && svc.healthy ? "ok" : "warn")
                            }.style({ padding: 10px 12px; border: 1px solid #e2e8f0; border-radius: 8px; })
                        }.style({ display: flex; flex-direction: column; gap: 8px; })
                    }
                    Route("/services/:id") { params =>
                        ServiceDetail(id: params.id, services: services)
                    }
                    Route("/settings") {
                        SettingsPanel()
                    }
                    Route("*") {
                        Column {
                            Text("No route matches {route.path}").style({ font-weight: 600; color: #b91c1c; })
                            Link("/", "Back to overview")
                        }
                    }
                }

                If(modal_open) {
                    Portal {
                        Column {
                            Panel(subtitle: "Confirm Rolling Restart") {
                                Text("Rendered via Portal into document.body with delegated events. Press Escape or Cancel to dismiss.").style({ color: #475569; font-size: 14px; })
                                Row(slot: "footer") {
                                    Button("Cancel") -> on_click(CloseModal)
                                    Button("Confirm Restart") -> on_click(ConfirmRestart)
                                }
                            }
                        }.style({
                            position: fixed;
                            inset: 0;
                            background: rgba(15, 23, 42, 0.45);
                            align-items: center;
                            justify-content: center;
                            z-index: 9999;
                            padding: 24px;
                        })
                    }
                }
            }.style({ gap: 16px; })
        }

        effect GoServices() { navigate("/services"); }
        effect SimulateOutage() { probe = ProbeState.Down("upstream timeout"); }
        effect TriggerFault() { fault_test = true; }
        effect OpenModal() { modal_open = true; }
        effect CloseModal() { modal_open = false; }
        effect ConfirmRestart() {
            probe = ProbeState.Online(11);
            modal_open = false;
        }
    }
}

view SettingsPanel {
    use FleetPrefs;

    store saved_notice: bool = false;

    state Ready {
        render {
            Panel(subtitle: "Fleet Alert Preferences (Shared Context)") {
                Form {
                    Column {
                        Row {
                            Text("Region filter:").style({ font-weight: 600; width: 130px; })
                            Select(value: FleetPrefs.region) {
                                Option(value: "all", "All regions")
                                Option(value: "iad", "US-East (iad)")
                                Option(value: "fra", "EU-West (fra)")
                                Option(value: "sjc", "US-West (sjc)")
                            } -> on_change(PickRegion)
                        }
                        Row {
                            Text("Latency SLO:").style({ font-weight: 600; width: 130px; })
                            Slider(value: FleetPrefs.slo_ms, min: 20, max: 200, step: 10) -> on_input(PickSlo)
                            Text(FleetPrefs.slo_label).style({ font-family: monospace; font-size: 13px; color: #0f4c81; })
                        }
                        Progress(value: FleetPrefs.slo_ms, max: 200)
                        If(saved_notice) {
                            Badge(text: "Preferences applied across all views", tone: "ok")
                        }
                        Row {
                            Button("Save Preferences") -> on_click(MarkSaved)
                            Button("Reset Defaults") -> on_click(FleetPrefs.ResetDefaults)
                        }
                    }.style({ gap: 12px; })
                } -> on_submit(MarkSaved)
            }
        }

        effect PickRegion(r: String) {
            FleetPrefs.SetRegion(r);
            saved_notice = false;
        }
        effect PickSlo(ms: i32) {
            FleetPrefs.SetSlo(ms);
            saved_notice = false;
        }
        effect MarkSaved() { saved_notice = true; }
    }
}

view ServiceDetail(id: String, services: Vec<Service>) {
    let found = services.find(|s| s.id == id);

    state Ready {
        render {
            If(found) {
                Panel(subtitle: found.name) {
                    Row(slot: "header") {
                        Text(found.name).style({ font-size: 18px; font-weight: 700; })
                        Badge(text: found.healthy ? "Healthy" : "Degraded", tone: found.healthy ? "ok" : "warn")
                    }
                    Text("Region: {found.region} — p95 latency: {found.latency_ms} ms").style({ color: #475569; font-size: 14px; })
                    Row(slot: "footer") {
                        Link("/services", "All services").style(NavLink)
                        Link("/services/edge-eu", "Switch to EU-West").style(NavLink)
                    }
                }
            } Else {
                Column {
                    Text("Unknown service: {id}").style({ font-weight: 600; color: #b91c1c; })
                    Link("/services", "Back to services")
                }
            }
        }
    }
}
