// GalleryCard — a note in Gallery view.
import "styles/shared"
import "components/menus/NoteMenu"

view GalleryCard(note: Note, selected: bool) {
    use Browse;
    use Vault;

    store menu: bool = false;
    store at: any = null;
    style { position: relative; }

    state Idle {
        render {
            Column(role: "option", aria: { selected: selected }, tab_index: selected ? 0 : -1,
                drag: note.id, drag_text: row_title(note), label: row_title(note)) {
                Column {
                    Image(src: thumb_of(note, Vault.unlocked), alt: "")
                        .style({ width: 100%; height: 100%; object-fit: cover; })
                    If(thumb_of(note, Vault.unlocked) == "") {
                        Text(card_text(note, Vault.unlocked), aria: { hidden: true }).style({
                            padding: 10px 12px;
                            font-size: 9.5px;
                            line-height: 1.45;
                            white-space: pre-wrap;
                            overflow: hidden;
                            color: var(--text);
                        })
                    }
                }.style({
                    height: 150px;
                    gap: 0;
                    overflow: hidden;
                    border-radius: 9px;
                    background: var(--window-bg);
                    box-shadow: selected ? 0 0 0 3px var(--accent) : 0 0 0 1px var(--hairline);
                    transition: box-shadow 0.12s, transform 0.12s;
                    @hover { transform: translateY(-1px); }
                })
                Text(row_title(note)).style({ @use Ellipsis; font-weight: 600; text-align: center; margin-top: 6px; })
                Text(fmt_short(note.updated)).style({ color: var(--muted); font-size: 11px; text-align: center; })
            } -> on_click(Pick) -> on_double_click(Open) -> on_context_menu(OpenMenu)
                .style({ gap: 1px; cursor: default; user-select: none; border-radius: 10px; })
            If(menu) {
                NoteMenu(note: note, at: at) -> on_done(CloseMenu)
            }
        }
        effect Pick() { Browse.Select(note.id); }
        effect Open() { Browse.Open(note.id); }
        effect OpenMenu(p: any) { at = p; menu = true; Browse.Select(note.id); }
        effect CloseMenu(x: any) { menu = false; }
        effect Dismiss() { menu = false; }
    }
}
