// NoteRow — a note in the list: a listbox option, draggable onto folders.
import "styles/shared"
import "components/menus/NoteMenu"

view NoteRow(note: Note, selected: bool, folders: Vec<Folder>, unlocked: bool, date: i64, folder_label: String) {
    store menu: bool = false;
    store at: any = null;
    style { position: relative; }

    state Idle {
        render {
            Row(role: "option", aria: { selected: selected }, tab_index: selected ? 0 : -1,
                drag: note.id, drag_text: row_title(note)) {
                Column {
                    Text(row_title(note)).style({ @use Ellipsis; font-weight: 600; font-size: 13px; })
                    Row {
                        Text(fmt_short(date)).style({ flex-shrink: 0; font-variant-numeric: tabular-nums; })
                        Text(preview_of(note, unlocked)).style({ @use Ellipsis; color: var(--muted); })
                    }.style({ gap: 7px; font-size: 12px; })
                    If(folder_label != "") {
                        Text("📁 " + folder_label).style({ @use Ellipsis; color: var(--muted); font-size: 11px; })
                    }
                }.style({ flex: 1; gap: 1px; min-width: 0; })
                Image(src: thumb_of(note, unlocked), alt: "")
                    .style({ width: 40px; height: 40px; object-fit: cover; border-radius: 6px; flex-shrink: 0; box-shadow: 0 0 0 0.5px var(--hairline); })
            } -> on_click(Pick) -> on_context_menu(OpenMenu)
                .style({
                    gap: 10px;
                    margin: 0 10px;
                    padding: 9px 12px;
                    border-radius: 8px;
                    cursor: default;
                    user-select: none;
                    box-shadow: 0 1px 0 var(--hairline);
                    background: selected ? var(--selection) : transparent;
                    transition: background 0.1s;
                })
            If(menu) {
                NoteMenu(note: note, folders: folders, unlocked: unlocked, at: at) -> on_action(Act)
            }
        }
        effect Pick() { emit select(note.id); }
        effect OpenMenu(p: any) { at = p; menu = true; emit select(note.id); }
        effect Act(a: any) { menu = false; emit action(a); }
        effect Dismiss() { menu = false; }
    }
}
