// HeaderBar — title, note count and the toolbar above the note list.
import "styles/shared"

view HeaderBar(title: String, count: i32, in_trash: bool, sidebar: bool, open: bool) {
    state Idle {
        render {
            Row {
                Button("◧", title: sidebar ? t("header.hideSidebar") : t("header.showSidebar"), aria: { pressed: sidebar }) -> on_click(Sidebar).style(IconButton)
                Column {
                    Text(title, role: "heading", aria: { level: 1 }).style({ @use Ellipsis; font-size: 15px; font-weight: 700; })
                    Text(t("list.count", { count: count })).style(Count)
                }.style({ flex: 1; gap: 0; min-width: 0; padding-left: 4px; })
                Button("☰", title: t("header.viewOptions"), aria: { haspopup: "menu", expanded: open }) -> on_click(Options).style(IconButton)
                If(!in_trash) { Button("✎", title: t("header.newNote")) -> on_click(New).style(IconButton) }
                If(in_trash && count > 0) { Button(t("header.deleteAll")) -> on_click(Empty).style(TextButton) }
            }.style(Toolbar)
        }
        effect Sidebar() { emit sidebar(true); }
        effect Options() { emit options(true); }
        effect New() { emit new(true); }
        effect Empty() { emit empty(true); }
    }
}
