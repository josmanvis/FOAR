// ListHeader — the list header plus its View options menu (List/Gallery, sort, group by date, language).
import "styles/shared"
import "./HeaderBar"
import "components/menus/MenuItem"

view ListHeader(title: String, count: i32) {
    use Library;
    use Browse;
    use Prefs;

    let in_trash: bool = Browse.in_trash;
    let sidebar: bool = Prefs.sidebar;

    style { position: relative; flex-shrink: 0; }

    state Idle {
        render {
            HeaderBar(title: title, count: count, in_trash: in_trash, sidebar: sidebar, open: false)
                -> on_sidebar(Sidebar) -> on_options(Options) -> on_new(New) -> on_empty(Empty)
        }
        effect Sidebar(x: any) { Prefs.ToggleSidebar(); }
        effect New(x: any) { Browse.NewNote(); }
        effect Options(x: any) { transition Options; }
        effect Empty(x: any) { transition ConfirmEmpty; }
    }

    state Options {
        on_key("Escape") { transition Idle; }

        render {
            HeaderBar(title: title, count: count, in_trash: in_trash, sidebar: sidebar, open: true)
                -> on_sidebar(Sidebar) -> on_options(Close) -> on_new(New) -> on_empty(Empty)
            Column(role: "menu", label: t("header.viewOptions")) {
                Text(t("view.viewAs"), aria: { hidden: true }).style(MenuTitle)
                MenuItem(label: t("view.list"), value: Layout.List, check: Prefs.layout == Layout.List) -> on_pick(PickLayout)
                MenuItem(label: t("view.gallery"), value: Layout.Gallery, check: Prefs.layout == Layout.Gallery) -> on_pick(PickLayout)
                Text("", role: "separator").style(MenuSep)
                Text(t("view.sortBy"), aria: { hidden: true }).style(MenuTitle)
                MenuItem(label: t("sort.edited"), value: SortBy.Edited, check: Prefs.sort == SortBy.Edited) -> on_pick(PickSort)
                MenuItem(label: t("sort.created"), value: SortBy.Created, check: Prefs.sort == SortBy.Created) -> on_pick(PickSort)
                MenuItem(label: t("sort.title"), value: SortBy.Title, check: Prefs.sort == SortBy.Title) -> on_pick(PickSort)
                Text("", role: "separator").style(MenuSep)
                MenuItem(label: t("view.group"), value: "group", check: Prefs.group_dates) -> on_pick(Group)
                Text("", role: "separator").style(MenuSep)
                Text(t("view.language"), aria: { hidden: true }).style(MenuTitle)
                List(available_locales()) { l =>
                    MenuItem(label: l.name, value: l.code, check: Prefs.locale == l.code) -> on_pick(Locale)
                }
            }.style(Menu, { left: auto; right: 10px; top: 46px; })
        }
        effect PickLayout(v: Layout) { Prefs.SetLayout(v); transition Idle; }
        effect PickSort(v: SortBy) { Prefs.SetSort(v); transition Idle; }
        effect Group(v: String) { Prefs.ToggleGroup(); transition Idle; }
        effect Locale(code: String) { Prefs.SetLocale(code); transition Idle; }
        effect Sidebar(x: any) { Prefs.ToggleSidebar(); transition Idle; }
        effect New(x: any) { Browse.NewNote(); transition Idle; }
        effect Empty(x: any) { transition ConfirmEmpty; }
        effect Close(x: any) { transition Idle; }
        effect Dismiss() { transition Idle; }
    }

    state ConfirmEmpty {
        on_key("Escape") { transition Idle; }

        render {
            HeaderBar(title: title, count: count, in_trash: in_trash, sidebar: sidebar, open: false)
                -> on_sidebar(Sidebar) -> on_options(Close) -> on_new(Close) -> on_empty(Close)
            Column(role: "alertdialog", label: t("confirm.emptyTrash")) {
                Text(t("confirm.emptyTrash")).style({ font-weight: 700; padding: 6px 8px 0; })
                Text(t("confirm.cantUndo")).style({ color: var(--muted); font-size: 12px; padding: 2px 8px 8px; })
                Row {
                    Button(t("common.cancel"), autofocus: true) -> on_click(Dismiss).style(TextButton, { flex: 1; })
                    Button(t("common.deleteAll")) -> on_click(Confirm).style(DangerButton, { flex: 1; })
                }.style({ gap: 6px; padding: 0 4px 4px; })
            }.style(Menu, { left: auto; right: 10px; top: 46px; width: 270px; })
        }
        effect Confirm() {
            Library.EmptyTrash();
            Browse.Show("all");
            transition Idle;
        }
        effect Sidebar(x: any) { Prefs.ToggleSidebar(); transition Idle; }
        effect Close(x: any) { transition Idle; }
        effect Dismiss() { transition Idle; }
        effect Cancel() { transition Idle; }
    }
}
