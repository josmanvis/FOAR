// PasswordSheet — set or enter the password of a locked note.
import "styles/shared"

view PasswordSheet(mode: String, error: String, hint: String) {
    store pw: String = "";
    store pw2: String = "";
    store hint_text: String = "";
    store local_error: String = "";

    style {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: grid;
        place-items: start center;
        background: rgba(0, 0, 0, 0.22);
        animation: fade-in 0.15s ease-out;
    }

    state Open {
        render {
            Column(role: "dialog", aria: { modal: true },
                label: mode == "create" ? t("lock.createTitle") : t("lock.enterTitle")) {
                Text("🔒", aria: { hidden: true }).style({ font-size: 36px; text-align: center; })
                Text(mode == "create" ? t("lock.createTitle") : t("lock.enterTitle"), role: "heading", aria: { level: 2 })
                    .style({ font-size: 14px; font-weight: 700; text-align: center; })
                Text(mode == "create" ? t("lock.createBody") : t("lock.enterBody"))
                    .style({ color: var(--muted); font-size: 12px; text-align: center; margin-bottom: 6px; })
                Input(value: pw, secure: true, placeholder: t("lock.password"), label: t("lock.password"), autofocus: true) -> on_input(Pw) -> on_enter(Submit)
                    .style(Field)
                If(mode == "create") {
                    Input(value: pw2, secure: true, placeholder: t("lock.verify"), label: t("lock.verify")) -> on_input(Pw2) -> on_enter(Submit).style(Field)
                    Input(value: hint_text, placeholder: t("lock.hintField"), label: t("lock.hintField")) -> on_input(Hint) -> on_enter(Submit).style(Field)
                }
                If(mode == "enter" && hint != "") {
                    Text(t("lock.hint", { hint: hint })).style({ color: var(--muted); font-size: 12px; })
                }
                If(local_error != "") { Text(local_error, role: "alert").style({ color: var(--danger); font-size: 12px; }) }
                If(error != "") { Text(error, role: "alert").style({ color: var(--danger); font-size: 12px; }) }
                Row {
                    Text("").style({ flex: 1; })
                    Button(t("common.cancel")) -> on_click(Cancel).style(TextButton)
                    Button(mode == "create" ? t("lock.setPassword") : t("common.ok")) -> on_click(Submit).style(PrimaryButton)
                }.style({ gap: 8px; margin-top: 8px; })
            }.style({
                width: 340px;
                gap: 8px;
                margin-top: 70px;
                padding: 22px;
                border-radius: 12px;
                background: var(--menu-bg);
                box-shadow: var(--shadow);
                animation: sheet-in 0.2s ease-out;
            })
        }

        effect Pw(v: String) { pw = v; }
        effect Pw2(v: String) { pw2 = v; }
        effect Hint(v: String) { hint_text = v; }
        effect Submit() {
            local_error = "";
            if pw.is_empty() {
                local_error = t("lock.errEmpty");
            } else if mode == "create" && pw != pw2 {
                local_error = t("lock.errMismatch");
            } else {
                let p = pw;
                let h = hint_text;
                emit submit({ password: p, hint: h });
            }
        }
        effect Cancel() { emit cancel(true); }
    }
}
