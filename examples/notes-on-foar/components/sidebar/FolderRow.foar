// FolderRow — a folder in the sidebar: select, drop notes on it, rename inline, delete with confirmation.
import "styles/shared"
import "components/menus/MenuItem"

view FolderRow(folder: Folder, count: i32, selected: bool, removable: bool) {
    use Library;
    use Browse;

    store draft: String = folder.name;
    store at: any = null;
    style { position: relative; }

    state Idle {
        render {
            Row(role: "listitem", aria: { current: selected ? "page" : null }, title: t("sidebar.dropToMove", { folder: folder.name })) {
                Text("📁", aria: { hidden: true }).style(SidebarIcon)
                Text(folder.name).style({ @use Ellipsis; flex: 1; })
                Text(count, label: t("list.count", { count: count })).style(Count)
            } -> on_click(Pick) -> on_double_click(StartRename) -> on_context_menu(OpenMenu) -> on_drop(DropNote)
                .style(SidebarItem, { background: selected ? var(--sidebar-selection) : transparent; })
        }
        effect Pick() { Browse.Show(folder.id); }
        effect StartRename() { draft = folder.name; transition Renaming; }
        effect OpenMenu(p: any) { at = p; transition Menu; }
        effect DropNote(id: String) { Library.Move(id, folder.id); }
    }

    state Menu {
        render {
            Row {
                Text("📁", aria: { hidden: true }).style(SidebarIcon)
                Text(folder.name).style({ @use Ellipsis; flex: 1; })
                Text(count).style(Count)
            }.style(SidebarItem, { background: var(--sidebar-selection); })
            Column(role: "menu", label: folder.name) {
                MenuItem(label: t("folder.rename"), value: "rename") -> on_pick(Choose)
                If(removable) {
                    MenuItem(label: t("folder.delete"), value: "delete", danger: true) -> on_pick(Choose)
                }
            }.style(Menu, { position: fixed; left: {at.x + "px"}; top: {at.y + "px"}; z-index: 200; })
        }
        effect Choose(v: String) {
            match v {
                "rename" => { draft = folder.name; transition Renaming; }
                _ => { transition ConfirmDelete; }
            }
        }
        effect Dismiss() { transition Idle; }
    }

    state Renaming {
        render {
            Row {
                Text("📁", aria: { hidden: true }).style(SidebarIcon)
                Input(value: draft, autofocus: true, label: t("folder.nameLabel")) -> on_input(Draft) -> on_enter(Commit) -> on_blur(Commit)
                    .style(RenameField)
            }.style(SidebarItem)
        }
        effect Draft(v: String) { draft = v; }
        effect Commit() {
            let name = draft.trim();
            if name != "" && name != folder.name { Library.RenameFolder(folder.id, name); }
            transition Idle;
        }
        effect Cancel() { transition Idle; }
    }

    state ConfirmDelete {
        render {
            Row {
                Text("📁", aria: { hidden: true }).style(SidebarIcon)
                Text(folder.name).style({ @use Ellipsis; flex: 1; })
                Text(count).style(Count)
            }.style(SidebarItem, { background: var(--sidebar-selection); })
            Column(role: "alertdialog", label: t("folder.confirmDelete", { name: folder.name })) {
                Text(t("folder.confirmDelete", { name: folder.name })).style({ font-weight: 700; padding: 4px 8px 0; })
                Text(t("folder.deleteBody")).style({ color: var(--muted); font-size: 12px; padding: 2px 8px 8px; })
                Row {
                    Button(t("common.cancel"), autofocus: true) -> on_click(Dismiss).style(TextButton, { flex: 1; })
                    Button(t("common.delete")) -> on_click(Confirm).style(DangerButton, { flex: 1; })
                }.style({ gap: 6px; padding: 0 4px 4px; })
            }.style(Menu, { width: 240px; })
        }
        effect Confirm() {
            Library.DeleteFolder(folder.id);
            if selected { Browse.Show("all"); }
        }
        effect Dismiss() { transition Idle; }
        effect Cancel() { transition Idle; }
    }
}
