// MenuItem — one row of a menu (label, optional check mark, shortcut hint).
import "styles/shared"

view MenuItem(label: String, value: String, check: bool, danger: bool, hint: String) {
    state Idle {
        render {
            Row(role: check ? "menuitemcheckbox" : "menuitem", aria: { checked: check ? true : null }, tab_index: -1) {
                Text(check ? "✓" : "", aria: { hidden: true }).style({ width: 14px; text-align: center; font-size: 12px; flex-shrink: 0; })
                Text(label).style({ @use Ellipsis; flex: 1; })
                If(hint != null && hint != "") {
                    Text(hint, aria: { hidden: true }).style({ opacity: 0.6; font-size: 11px; padding-left: 14px; })
                }
            } -> on_click(Pick)
                .style(MenuRow, { color: danger ? var(--danger) : inherit; })
        }
        effect Pick() { emit pick(value); }
    }
}
