// NoteMenu — the actions menu of a note (pin, lock, move, delete ...).
import "styles/shared"
import "./MenuItem"

// Each item does its thing and emits `done`, so the menu's owner closes it.
view NoteMenu(note: Note, at: any) {
    use Library;
    use Browse;
    use Vault;

    let is_deleted: bool = note.deleted_at > 0;
    let can_read: bool = !note.locked || Vault.unlocked;

    style {
        position: {at ? "fixed" : ""};
        left: {at ? at.x + "px" : ""};
        top: {at ? at.y + "px" : ""};
        z-index: 200;
    }

    state Main {
        render {
            Column(role: "menu", label: t("note.menuLabel")) {
                If(is_deleted) {
                    MenuItem(label: t("note.recover"), value: "recover") -> on_pick(Recover)
                    MenuItem(label: t("note.purge"), value: "purge", danger: true) -> on_pick(AskPurge)
                } Else {
                    MenuItem(label: note.pinned ? t("note.unpin") : t("note.pin"), value: "pin") -> on_pick(Pin)
                    If(!note.locked) {
                        MenuItem(label: t("note.lock"), value: "lock") -> on_pick(Lock)
                    } Else If(Vault.unlocked) {
                        MenuItem(label: t("note.removeLock"), value: "remove_lock") -> on_pick(RemoveLock)
                    }
                    MenuItem(label: t("note.moveTo"), value: "move") -> on_pick(StartMove)
                    If(can_read) {
                        MenuItem(label: t("note.duplicate"), value: "duplicate") -> on_pick(Duplicate)
                        Text("", role: "separator").style(MenuSep)
                        MenuItem(label: t("note.exportMd"), value: "export_md") -> on_pick(Export)
                        MenuItem(label: t("note.exportHtml"), value: "export_html") -> on_pick(Export)
                        MenuItem(label: t("note.print"), value: "print", hint: "Ctrl/⌘ P") -> on_pick(Export)
                    }
                    Text("", role: "separator").style(MenuSep)
                    MenuItem(label: t("note.delete"), value: "delete", danger: true, hint: "Ctrl/⌘ ⌫") -> on_pick(Trash)
                }
            }.style(Menu, { position: at ? static : absolute; })
        }
        effect Pin(x: any) { Library.TogglePin(note.id); emit done(true); }
        effect Lock(x: any) { Vault.Lock(note.id); emit done(true); }
        effect RemoveLock(x: any) { Library.SetLocked(note.id, false); emit done(true); }
        effect Export(kind: String) { Library.Export(kind, note.id); emit done(true); }
        effect Trash(x: any) { Library.Trash(note.id); emit done(true); }
        effect Recover(x: any) { Library.Recover(note.id); emit done(true); }
        effect Duplicate(x: any) {
            let copy_id = random_uuid();
            Library.Duplicate(note.id, copy_id);
            Browse.Select(copy_id);
            emit done(true);
        }
        effect StartMove(x: any) { transition Moving; }
        effect AskPurge(x: any) { transition ConfirmPurge; }
    }

    state Moving {
        on_key("Escape") { transition Main; }

        render {
            Column(role: "menu", label: t("note.moveTitle")) {
                Text(t("note.moveTitle"), aria: { hidden: true }).style(MenuTitle)
                List(by_name(Library.folders)) { f =>
                    MenuItem(label: f.name, value: f.id, check: f.id == note.folder) -> on_pick(MoveTo)
                }
            }.style(Menu, { position: at ? static : absolute; })
        }
        effect MoveTo(folder: String) { Library.Move(note.id, folder); emit done(true); }
    }

    state ConfirmPurge {
        on_key("Escape") { transition Main; }

        render {
            Column(role: "alertdialog", label: t("note.purgeConfirm")) {
                Text(t("note.purgeConfirm")).style({ font-weight: 700; padding: 6px 8px 0; })
                Text(t("confirm.cantUndo")).style({ color: var(--muted); font-size: 12px; padding: 2px 8px 8px; })
                Row {
                    Button(t("common.cancel"), autofocus: true) -> on_click(Back).style(TextButton, { flex: 1; })
                    Button(t("common.delete")) -> on_click(Purge).style(DangerButton, { flex: 1; })
                }.style({ gap: 6px; padding: 0 4px 4px; })
            }.style(Menu, { width: 250px; position: at ? static : absolute; })
        }
        effect Back() { transition Main; }
        effect Purge() { Library.Purge(note.id); emit done(true); }
    }
}
