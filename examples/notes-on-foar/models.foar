// Data types and enums shared by every view.

enum Layout {
    List = "list",
    Gallery = "gallery",
}

enum SortBy {
    Edited = "edited",
    Created = "created",
    Title = "title",
}

enum SheetMode {
    Closed = "",
    Create = "create",
    Enter = "enter",
}

data Note {
    id: String,
    folder: String,
    title: String,
    html: String,
    created: i64,
    updated: i64,
    pinned: bool,
    deleted_at: i64,
    locked: bool,
}

data Folder {
    id: String,
    name: String,
}
