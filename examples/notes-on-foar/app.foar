// Notes on FOAR
// A macOS Notes-style app: folders, tags, search, rich text, locked notes, three languages.
//
// The data lives in four contexts (shared stores) under stores/:
//   Library  notes and folders, and every change to them
//   Browse   the folder, tag or search you're looking at, and the selected note
//   Prefs    sort, grouping, layout, sidebar, language
//   Vault    the password for locked notes
// plus Toasts for the Undo message. Components call them directly
// (`Library.Trash(note.id)`), so this file is just the window's layout.

import "models"
import "styles/theme"
import "styles/shared"
import "stores/Library"
import "stores/Browse"
import "stores/Prefs"
import "stores/Vault"
import "stores/Toasts"
import "components/sidebar/FolderRow"
import "components/sidebar/NewFolderRow"
import "components/sidebar/TagChip"
import "components/list/ListHeader"
import "components/list/NoteRow"
import "components/list/GalleryCard"
import "components/menus/ContextMenu"
import "components/editor/NoteEditor"
import "components/PasswordSheet"
import "components/Toast"

view NotesApp {
    use Library;
    use Browse;
    use Prefs;
    use Vault;
    use Toasts;

    // the right-click menu of the sidebar or the list background
    store menu_at: any = null;
    store menu_items: Vec<any> = [];

    let header_title: String = view_title(Browse.view, Library.folders);
    let show_folder_badge: bool = Browse.view == "all" || Browse.view.startsWith("tag:") || Browse.query != "";

    style {
        layout: horizontal;
        width: 100%;
        height: 100%;
        min-height: 100%;
        overflow: hidden;
        background: var(--window-bg);
        color: var(--text);
        font: 13px/1.4 var(--font);
        -webkit-font-smoothing: antialiased;
        animation: fade-in 0.25s ease-out;
    }

    state Ready {
        // Menus and the password sheet close themselves first (the innermost
        // on_key wins); after that, Escape leaves a note opened from the gallery.
        on_key("Escape") { Browse.CloseNote(); }

        render {
            // ---- sidebar ------------------------------------------------------
            If(Prefs.sidebar) {
                Column(role: "navigation", label: t("sidebar.label")) {
                    Row { }.style(Toolbar)

                    Row(aria: { current: Browse.view == "all" ? "page" : null }) {
                        Text("🗂", aria: { hidden: true }).style(SidebarIcon)
                        Text(t("sidebar.allNotes")).style({ @use Ellipsis; flex: 1; })
                        Text(count_in(Library.notes, "all")).style(Count)
                    } -> on_click(ShowAll)
                        .style(SidebarItem, { background: Browse.view == "all" ? var(--sidebar-selection) : transparent; })

                    Text(t("sidebar.folders"), role: "heading", aria: { level: 2 }).style(SectionLabel)
                    List(by_name(Library.folders), role: "list") { f =>
                        FolderRow(folder: f, count: count_in(Library.notes, f.id), selected: Browse.view == f.id, removable: f.id != "notes")
                    }

                    If(Library.deleted_count > 0) {
                        Row(aria: { current: Browse.in_trash ? "page" : null }, title: t("sidebar.dropToDelete")) {
                            Text("🗑", aria: { hidden: true }).style(SidebarIcon)
                            Text(t("sidebar.deleted")).style({ @use Ellipsis; flex: 1; })
                            Text(Library.deleted_count).style(Count)
                        } -> on_click(ShowDeleted) -> on_drop(Library.Trash)
                            .style(SidebarItem, { background: Browse.in_trash ? var(--sidebar-selection) : transparent; })
                    }

                    If(Library.tags.len() > 0) {
                        Text(t("sidebar.tags"), role: "heading", aria: { level: 2 }).style(SectionLabel)
                        List(Library.tags, role: "group", label: t("sidebar.tags")) { tg =>
                            TagChip(tag: tg, selected: Browse.view == "tag:" + tg.name)
                        }.style({ display: flex; flex-wrap: wrap; gap: 6px; padding: 2px 8px; })
                    }

                    Text("").style({ flex: 1; min-height: 20px; })
                    If(Vault.unlocked) {
                        Button("🔒  " + t("sidebar.lockAll"), title: t("sidebar.lockAllHint"))
                            -> on_click(Vault.LockAll).style(SidebarFooterButton)
                    }
                    NewFolderRow()
                } -> on_context_menu(SidebarMenu).style(Sidebar)

                Row(role: "separator", label: t("sidebar.resize"), tab_index: 0, aria: { orientation: "vertical", valuemin: 150, valuemax: 360, valuenow: 185 }) { }
                    .style(SidebarSplitter)
            }

            // ---- notes: a list with the editor beside it, or a gallery --------
            Match(Prefs.layout) {
                List => {
                    Column(role: "region", label: t("list.label")) {
                        ListHeader(title: header_title, count: Browse.shown.len())
                        Input(value: Browse.query, placeholder: t("list.search"), label: t("list.searchLabel"))
                            -> on_input(Browse.Search)
                            .style(Field, { margin: 0 12px 6px; flex-shrink: 0; })

                        List(Browse.groups, empty: empty_text(Browse.view, Browse.query), role: "listbox", label: header_title) { g =>
                            If(g.label != "") { Text(g.label, role: "presentation").style(GroupLabel) }
                            List(g.notes) { note =>
                                NoteRow(
                                    note: note,
                                    selected: note.id == Browse.selected,
                                    date: Prefs.sort == SortBy.Created ? note.created : note.updated,
                                    folder_label: show_folder_badge ? folder_name(Library.folders, note.folder) : ""
                                )
                            }.style({ display: contents; })
                        } -> on_context_menu(ListMenu).style(NoteScroller)
                    }.style(ListPane)

                    Row(role: "separator", label: t("list.resize"), tab_index: 0, aria: { orientation: "vertical", valuemin: 190, valuemax: 460, valuenow: 230 }) { }
                        .style(ListSplitter)

                    List(Browse.selected_notes, empty: "") { note =>
                        NoteEditor(note: note, gallery: false, fresh: note.id == Browse.fresh)
                    }.style(EditorPane)
                }

                Gallery => If(Browse.gallery_open) {
                    List(Browse.selected_notes, empty: "") { note =>
                        NoteEditor(note: note, gallery: true, fresh: note.id == Browse.fresh)
                    }.style(EditorPane)
                } Else {
                    Column(role: "region", label: t("list.label")) {
                        ListHeader(title: header_title, count: Browse.shown.len())
                        Input(value: Browse.query, placeholder: t("list.search"), label: t("list.searchLabel"))
                            -> on_input(Browse.Search)
                            .style(Field, { width: 320px; margin: 0 22px 6px; flex-shrink: 0; })

                        List(Browse.groups, empty: empty_text(Browse.view, Browse.query), role: "listbox", label: header_title) { g =>
                            If(g.label != "") { Text(g.label, role: "presentation").style(GroupLabel) }
                            List(g.notes) { note =>
                                GalleryCard(note: note, selected: note.id == Browse.selected)
                            }.style(GalleryGrid)
                        } -> on_context_menu(ListMenu).style(GalleryScroller)
                    }.style({ flex: 1; gap: 0; min-width: 0; background: var(--list-bg); })
                }
            }

            // ---- on top ---------------------------------------------------------
            If(menu_at != null) {
                ContextMenu(at: menu_at, items: menu_items, label: t("menu.label"))
                    -> on_pick(MenuPick) -> on_close(CloseMenu)
            }

            Match(Vault.sheet) {
                Create | Enter => PasswordSheet(mode: Vault.sheet, error: Vault.error, hint: Vault.hint)
                    -> on_submit(Vault.Submit) -> on_cancel(Vault.Cancel)
                Closed => Text("").style({ display: none; })
            }

            // a live region: screen readers announce toasts
            Column(role: "status", aria: { live: "polite" }) {
                If(Toasts.current != None) { Toast() }
            }.style({ display: contents; })
        }

        effect ShowAll() { Browse.Show("all"); }
        effect ShowDeleted() { Browse.Show("deleted"); }

        // ---- right-click menus ------------------------------------------------
        effect SidebarMenu(p: any) {
            menu_items = [
                { label: t("sidebar.newFolder"), value: "new-folder", hint: "Ctrl/⌘ ⇧ N" },
                { sep: true },
                { label: Prefs.sidebar ? t("header.hideSidebar") : t("header.showSidebar"), value: "sidebar" },
            ];
            menu_at = p;
        }

        effect ListMenu(p: any) {
            menu_items = [
                { label: t("menu.newNote"), value: "new-note", hint: "Ctrl/⌘ ⌥ N", disabled: Browse.in_trash },
                { sep: true, disabled: Browse.in_trash },
                { title: t("view.viewAs") },
                { label: t("view.list"), value: "layout:list", check: Prefs.layout == Layout.List },
                { label: t("view.gallery"), value: "layout:gallery", check: Prefs.layout == Layout.Gallery },
                { sep: true },
                { title: t("view.sortBy") },
                { label: t("sort.edited"), value: "sort:edited", check: Prefs.sort == SortBy.Edited },
                { label: t("sort.created"), value: "sort:created", check: Prefs.sort == SortBy.Created },
                { label: t("sort.title"), value: "sort:title", check: Prefs.sort == SortBy.Title },
                { sep: true },
                { label: t("view.group"), value: "group", check: Prefs.group_dates },
            ].filter(|i| !i.disabled);
            menu_at = p;
        }

        effect MenuPick(v: String) {
            menu_at = null;
            match v {
                "new-folder" => start_new_folder(),
                "new-note" => Browse.NewNote(),
                "sidebar" => Prefs.ToggleSidebar(),
                "group" => Prefs.ToggleGroup(),
                "layout:list" => Prefs.SetLayout(Layout.List),
                "layout:gallery" => Prefs.SetLayout(Layout.Gallery),
                "sort:edited" => Prefs.SetSort(SortBy.Edited),
                "sort:created" => Prefs.SetSort(SortBy.Created),
                "sort:title" => Prefs.SetSort(SortBy.Title),
                _ => {}
            }
        }

        effect CloseMenu(x: any) { menu_at = null; }
    }
}

style Sidebar {
    box-sizing: border-box;
    width: var(--sidebar-w);
    min-width: 150px;
    max-width: 420px;
    flex-shrink: 0;
    gap: 1px;
    padding: 0 10px 10px;
    background: var(--sidebar-bg);
    border-right: 1px solid var(--hairline);
    overflow-y: auto;
    animation: fade-in 0.15s ease-out;
}

style SidebarFooterButton {
    height: 30px;
    padding: 0 10px;
    border: none;
    border-radius: 7px;
    background: transparent;
    color: var(--muted);
    font: 13px var(--font);
    text-align: left;
    flex-shrink: 0;
    @hover { background: var(--sidebar-selection); color: var(--text); }
}

style ListPane {
    box-sizing: border-box;
    width: var(--list-w);
    min-width: 190px;
    max-width: 640px;
    flex-shrink: 0;
    gap: 0;
    min-height: 0;
    background: var(--list-bg);
    border-right: 1px solid var(--hairline);
}

style NoteScroller {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding-bottom: 12px;
}

style EditorPane {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--window-bg);
}

style GalleryScroller {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding: 0 10px 30px;
}

style GalleryGrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 22px 18px;
    padding: 4px 12px 10px;
}
