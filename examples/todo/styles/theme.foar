// Theme, shared styles and animations: plain CSS, compiled once by the Rust
// compiler into one stylesheet.

theme {
    --accent: #0b63ce;
    --radius: 6px;
    --row-hover: #f9f9f9;
    --muted: #767676;
    @dark { --row-hover: #1c2128; }
}

style Field {
    padding: 10px;
    border-radius: var(--radius);
    border: 1px solid #ccc;
    @focus { border-color: var(--accent); }
}

@keyframes slide-in {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: none; }
}

style FilterButton {
    border: 0;
    background: transparent;
    padding: 4px 8px;
    border-radius: var(--radius);
    cursor: pointer;
    @hover { background: var(--row-hover); }
}
