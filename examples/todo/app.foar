// Todo App — sub-views with their own state machines, events, a theme and data
// Split into files:
//   app.foar                  the root view (this file)
//   models.foar               data Todo, enum Filter
//   styles/theme.foar         theme, shared styles, animations
//   components/TodoItem.foar  one todo: Idle / Editing states
import "models"
import "styles/theme"
import "components/TodoItem"

view TodoApp {
    // Persistent View State
    store todos: Vec<Todo> = [
        Todo { id: "todo-1", text: "Design explicit topological UI states", completed: true },
        Todo { id: "todo-2", text: "Double-click or click Edit to test Editing state", completed: false },
        Todo { id: "todo-3", text: "Eliminate React boolean flags forever", completed: false },
    ];
    store search_query: String = "";
    store draft: String = "";
    store filter: Filter = Filter.All;

    // Derived values: recomputed on every update, no dependency lists
    let remaining = todos.filter(|t| !t.completed).len();
    let visible = todos
        .filter(|t| t.text.contains(search_query))
        .filter(|t| match filter {
            Filter.All => true,
            Filter.Active => !t.completed,
            Filter.Done => t.completed,
        });

    // Base styling applied to the host element
    style {
        layout: vertical;
        padding: 32px;
        gap: 20px;
        max-width: 600px;
        font-family: system-ui;
    }

    // The App is always active in this example
    state Active {
        render {
            Text("FOAR Todo App")
                .style({ font-size: 32px; font-weight: bold; color: #333; })

            // Search Bar
            Input(value: search_query, placeholder: "🔍 Search todos...", label: "Search todos")
                -> on_input(UpdateSearch)
                .style(Field)

            // Create New Todo Row
            Row {
                Input(value: draft, placeholder: "What needs to be done?", label: "New todo")
                    -> on_input(UpdateDraft)
                    -> on_enter(AddTodo)
                    .style(Field, { flex: 1; })

                Button("Add")
                    -> on_click(AddTodo)
                    .style({ background: #0b63ce; color: white; border-radius: 6px; padding: 0 20px; })
            }

            // Keyed list: rows are reused, not rebuilt
            List(visible, empty: "Nothing here.") { todo =>
                // Instantiate sub-view and listen to its emitted events
                TodoItem(item: todo)
                    -> on_delete(RemoveTodo)
                    -> on_update(UpdateTodo)
            }

            // Footer: a Match picks the message (the compiler checks every case)
            Row {
                Column {
                    Match(remaining) {
                        0 => Text("All done 🎉"),
                        1 => Text("1 item left"),
                        n => Text("{n} items left"),
                    }
                }.style({ flex: 1; color: var(--muted); })

                Button("All") -> on_click(ShowAll).style(FilterButton, { font-weight: filter == Filter.All ? 700 : 400; })
                Button("Active") -> on_click(ShowActive).style(FilterButton, { font-weight: filter == Filter.Active ? 700 : 400; })
                Button("Done") -> on_click(ShowDone).style(FilterButton, { font-weight: filter == Filter.Done ? 700 : 400; })
            }
        }

        effect ShowAll() { filter = Filter.All; }
        effect ShowActive() { filter = Filter.Active; }
        effect ShowDone() { filter = Filter.Done; }

        // --- Effects (Transitions & Data Mutations) ---
        effect UpdateSearch(query: String) {
            search_query = query;
        }

        effect UpdateDraft(text: String) {
            draft = text;
        }

        effect AddTodo() {
            if draft.is_empty() { return; }
            todos.push(Todo {
                id: random_uuid(),
                text: draft,
                completed: false
            });
            draft = ""; // Clear input
        }

        effect RemoveTodo(id: String) {
            todos.retain(|t| t.id != id);
        }

        effect UpdateTodo(updated: Todo) {
            if let Some(index) = todos.find_index(|t| t.id == updated.id) {
                todos[index] = updated;
            }
        }
    }
}
