// OrderRow — one order. Its badge, colour and buttons come from matches on
// `order.status`; add a variant to Status and each of them stops compiling
// until it handles it.
import "../models"

view OrderRow(order: Order) {
    // ranges and alternatives
    let size = match order.items {
        1 => "1 item",
        2..=4 => "{order.items} items",
        _ => "{order.items} items · bulk",
    };
    let label = match order.status {
        Status.Cancelled => "Cancelled",
        other => other,
    };
    let tone = match order.status {
        Status.Pending => "#9a6700",
        Status.Paid => "#0969da",
        Status.Shipped => "#8250df",
        Status.Delivered => "#1a7f37",
        Status.Cancelled => "#cf222e",
    };

    style {
        layout: horizontal;
        align: center;
        gap: 12px;
        padding: 12px 14px;
        border: 1px solid #d0d7de;
        border-radius: 10px;
    }

    state Idle {
        render {
            Column {
                Text("{order.id} · {order.customer}").style({ font-weight: 600; })
                Text("{size} · ${order.total}").style({ color: #57606a; font-size: 13px; })
            }.style({ flex: 1; gap: 2px; })

            Text(label).style({
                color: tone;
                border: 1px solid tone;
                border-radius: 999px;
                padding: 2px 10px;
                font-size: 12px;
            })

            // render Match: the buttons each status allows
            Match(order.status) {
                Pending => { Button("Mark paid") -> on_click(Advance) Button("Cancel") -> on_click(Cancel) }
                Paid => { Button("Ship") -> on_click(Advance) Button("Cancel") -> on_click(Cancel) }
                Shipped => Button("Delivered") -> on_click(Advance),
                Delivered | Cancelled => Text("—").style({ color: #8c959f; }),
            }
        }

        effect Advance() { emit advance(order.id); }
        effect Cancel() { emit cancel(order.id); }
    }
}
